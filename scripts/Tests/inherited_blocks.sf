#!/usr/bin/ruby

class Foo() {

    has a = {|n| n+42 }
    has b = {|n| n+99 }

    method b_block {
        b
    }
}

class Bar < Foo {
    method a_block {
        self.a
    }
}

assert_eq(Foo().a()(42), 42+42)
assert_eq(Bar().a()(43), 43+42)

var foo_obj = Foo()
var bar_obj = Bar()

# Each object has its own block (a closure), inherited by the subclass
assert_eq(bar_obj.a()(1), foo_obj.a()(1))
assert_eq(bar_obj.b()(1), foo_obj.b()(1))

assert_eq(bar_obj.a_block()(1), foo_obj.a()(1))
assert_eq(bar_obj.b_block()(1), foo_obj.b()(1))
assert_eq(foo_obj.b_block()(1), bar_obj.b()(1))
assert_eq(bar_obj.a, bar_obj.a)

assert_eq(bar_obj.b_block()(1), 100)
assert_eq(foo_obj.b_block()(1), 100)

assert_eq(bar_obj.a_block()(10), 52)

say "** Test passed!"

#!/usr/bin/ruby

# Tests for Number `solve_thue()` function

# Standard cases (k = 4, positive D)
assert_eq(solve_thue(5, 4), [[3, 2]])                 # 3^4 - 5*2^4 = 1
assert_eq(solve_thue(2, 4, -1), [[1, 1]])             # 1^4 - 2*1^4 = -1
assert_eq(solve_thue(7140, 4, 1, 50), [[239, 26]])   # 239^4 - 7140*26^4 = 1

# Cubic cases (k = 3, negative D with multiple solutions)
assert_eq(solve_thue(-2, 3, 3), [[1, 1], [-5, 4]])    # 1^3 - (-2)*1^3 = 3 and (-5)^3 - (-2)*4^3 = 3

# Perfect k-th power D cases (D = d^k)
assert_eq(solve_thue(4, 2, 5), [[3, 1]])              # 3^2 - 4*1^2 = 5 (D = 2^2)
assert_eq(solve_thue(8, 3, 1), [])                    # x^3 - 8*y^3 = 1 has no positive y solutions
assert_eq(solve_thue(27, 3, -19), [[2, 1]])           # 2^3 - 27*1^3 = -19 (D = 3^3)

# D = 0 edge cases (x^k = N)
assert_eq(solve_thue(0, 2, 16), [[4, 0]])             # 4^2 - 0*0^2 = 16
assert_eq(solve_thue(0, 3, -27), [[-3, 0]])           # (-3)^3 - 0*0^3 = -27
assert_eq(solve_thue(0, 2, -4), [])                   # No solution for even k with negative N

# Linear case (k = 1)
assert_eq(solve_thue(3, 1, 5, 2), [[8, 1], [11, 2]])   # x - 3*y = 5 for y in [1, 2]

# Bounded search / first_only flag
assert_eq(solve_thue(-2, 3, 3, 10, true), [[1, 1]])    # Returns only the first valid solution

assert_eq(solve_thue(5, 4), [[3, 2]])   #          (3^4 - 5*2^4 = 1)
assert_eq(solve_thue(2, 4, -1), [[1, 1]])   #           (1^4 - 2*1^4 = -1)
assert_eq(solve_thue(7140, 4, 1, 50), [[239, 26]]) #         (239^4 - 7140*26^4 = 1)
assert_eq(solve_thue(-2, 3, 3), [[1, 1], [-5, 4]]) #   (both are exact)

# Prime N values with odd degree (k = 3)
assert_eq(solve_thue(3, 3, 5), [[2, 1]])               # 2^3 - 3*1^3 = 5 (N = 5 prime)
assert_eq(solve_thue(2, 3, 19), [])                    # (no solutions)
assert_eq(solve_thue(6, 3, -7), [[-1, 1]])             # (-1)^3 - 6*1^3 = -7 (N = -7 prime)

# Large integer inputs (Pell-type and large coefficient cases)
assert_eq(solve_thue(2, 2, 1, 100), [[3, 2], [17, 12], [99, 70]]) # Solutions to x^2 - 2y^2 = 1 up to y <= 100
assert_eq(solve_thue(13, 2, -4), [[3, 1], [36, 10], [393, 109]])             # 3^2 - 13*1^2 = -4
assert_eq(solve_thue(15, 2, 1, 10), [[4, 1],[31, 8]])           # 4^2 - 15*1^2 = 1

# Higher powers (k = 5, k = 6)
assert_eq(solve_thue(3, 5, 29), [[2, 1]])              # 2^5 - 3*1^5 = 29 (N = 29 prime)
assert_eq(solve_thue(2, 6, 62), [[2, 1]])              # 2^6 - 2*1^6 = 62

# Perfect square D with prime N (k = 2)
assert_eq(solve_thue(9, 2, 7), [[4, 1]])               # 4^2 - 9*1^2 = 7 (D = 3^2, N = 7 prime)
assert_eq(solve_thue(16, 2, -7), [[3, 1]])             # 3^2 - 16*1^2 = -7 (D = 4^2, N = -7 prime)

say "All tests passed successfully!"

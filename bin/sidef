#!/usr/bin/env perl

use utf8;
use 5.016;

BEGIN {    # support for running sidef locally from everywhere
    if (-w __FILE__) {
        require File::Spec;
        require File::Basename;
        unshift @INC,
          File::Spec->catdir(
                             File::Basename::dirname(
                                                       File::Spec->file_name_is_absolute(__FILE__)
                                                     ? __FILE__
                                                     : File::Spec->rel2abs(__FILE__)
                                                    ),
                             File::Spec->updir,
                             'lib'
                            );
    }
}

binmode STDIN,  ":utf8";
binmode STDOUT, ":utf8";
binmode STDERR, ":utf8" if $^P == 0;    # to work under Devel::* modules

if ($^O eq "MSWin32") {
    eval {
        # Workaround for warning on Windows
        require Term::ReadLine::readline;
        *Term::ReadLine::readline::get_window_size = sub { (80, 24) };
    };
}

use Sidef;

my $name    = 'Sidef';
my $version = $Sidef::VERSION;

my %args;
if ($#ARGV != -1 and substr($ARGV[0], 0, 1) eq '-') {
    require Getopt::Std;
    $Getopt::Std::STANDARD_HELP_VERSION = 1;
    Getopt::Std::getopts('e:E:Dho:ivHWwbcrR:tCO:kP:M:sN:', \%args);
}

# Fix potential case mismatches for -R
if (defined $args{R}) {
    if (lc($args{R}) eq 'perl') {
        $args{R} = 'Perl';
    }
    elsif (lc($args{R}) eq 'sidef') {
        $args{R} = 'Sidef';
    }
}

# Help
if (defined $args{h}) {
    HELP_MESSAGE();
    exit 0;
}

# Version
if (defined $args{v}) {
    VERSION_MESSAGE();
    exit 0;
}

# Warnings stack backtrace
if (defined $args{w}) {
    $SIG{__WARN__} = sub {
        require Carp;
        Carp::cluck(@_);
    };
}

# Fatal warnings stack backtrace
if (defined $args{W}) {
    $SIG{__DIE__} = $SIG{__WARN__} = sub {
        require Carp;
        Carp::confess(@_);
    };
}

# Interactive help
if (defined $args{H}) {
    help_interactive();
    exit 0;
}

# Interactive coding
if (defined $args{i}) {
    code_interactive();
    exit 0;
}

# Precision
if (defined $args{P}) {
    require Sidef::Types::Number::Number;
    if ($args{P} <= 0) {
        die "Invalid precision: <<$args{P}>> (expected a positive integer)\n";
    }
    $Sidef::Types::Number::Number::PREC = $args{P} << 2;
}

# Other Number options
if (defined $args{N}) {
    require Sidef::Types::Number::Number;
    my @options = split(/\s*;\s*/, $args{N});
    foreach my $option (@options) {
        if ($option =~ /^\s*(\w+)\s*=\s*(\S+)/) {
            my ($name, $value) = ($1, $2);

            if ($value eq 'true') {
                $value = 1;
            }
            elsif ($value eq 'false') {
                $value = 0;
            }

            no strict 'refs';
            ${'Sidef::Types::Number::Number::' . $name} = $value;
        }
        else {
            die "Invalid format: <<$option>>!\nExpected: 'NAME1=VALUE1; NAME2=VALUE2;'";
        }
    }
}

# Test mode
if (defined $args{t}) {

    local $args{c} = 0;
    my @argv = splice(@ARGV);

    my @fails;
    require Encode;
    while (defined(my $script_name = shift @argv)) {

        my $script_name = Encode::decode_utf8($script_name);

        say "\n** Executing: $script_name";
        say "-" x 80;

        my $sidef = Sidef->new(opt  => \%args,
                               name => $script_name);

        my $code     = read_script($script_name);
        my $deparsed = eval { $sidef->compile_code($code, 'Perl') };

        my $slept = 0;
        if ($@) {
            warn "[ERROR] Can't parse the script `$script_name`: $@";
            push @fails, $script_name;
            sleep 2;
            $slept = 1;
        }
        else {
            local $SIG{INT} = sub {
                die "Stopped by user...";
            };

            if (defined $args{C}) {
                say "$script_name syntax OK";
                next;
            }

            $sidef->execute_perl($deparsed);
        }

        if (not($slept) and $@) {
            warn "[ERROR] Error encountered on script `$script_name`: $@";
            push @fails, $script_name;
            sleep(2) if @argv;
        }
    }

    if (@fails) {
        say "\n";
        say "-" x 80;
        say ":: The following scripts failed";
        say "-" x 80;
        say "$_" for @fails;
    }
}

# Default
else {
    my $script_name = '-';

    $args{E} = $args{e} if exists($args{e});

    my $code = exists($args{E})
      ? do {
        defined($args{E}) || die "No code specified for -E.\n";
        $script_name = '-E';
        require Encode;
        Encode::decode_utf8($args{E});
      }
      : defined($ARGV[0]) ? do {
        $script_name = shift @ARGV;
        if ($script_name eq '-') {
            local $/;
            <STDIN>;
        }
        else {
            read_script($script_name);
        }
      }
      : (-t STDIN) ? do { code_interactive(); exit 0; }
      :              do { local $/;           <STDIN> };

    $code // exit 2;

    my $sidef = Sidef->new(opt  => \%args,
                           name => $script_name);

    # Dump the AST
    if (defined $args{D}) {
        dump_ast($sidef->parse_code($code));
    }

    # Deparse code
    elsif (defined($args{r}) or defined($args{R})) {
        my $deparsed = $sidef->compile_code($code, $args{R});

        if (defined($args{R}) and $args{R} eq 'Perl') {

            require File::Basename;

            my $header =
                "\nuse lib (" . q{"}
              . quotemeta(File::Basename::dirname($INC{"Sidef.pm"})) . q{"}
              . ");\n\n"
              . "use Sidef;\n\n"
              . "binmode(STDIN, ':utf8');\n"
              . "binmode(STDOUT, ':utf8');\n"
              . "binmode(STDERR, ':utf8') if \$^P == 0;\n";

            $deparsed = $header . $deparsed;
        }

        output($deparsed);
    }

    # Compile the code to a Perl program
    elsif (defined $args{c}) {
        compile_to_perl(code => $sidef->compile_code($code, 'Perl'));
    }

    # Check the syntax
    elsif (defined $args{C}) {
        eval { $sidef->parse_code($code) };
        die $@ if $@;
        say "$script_name syntax OK";
    }

    # Execute the code
    else {
        $sidef->execute_code($code);
        die $@ if $@;
    }
}

#
## Subroutines
#

sub HELP_MESSAGE {
#<<<
    my %switches = (
                    '-c'         => 'compile the code into a stand-alone Perl program',
                    '-C'         => 'check syntax only (parse without execution)',
                    '-D'         => 'dump the Abstract Syntax Tree (AST) of the program',
                    '-E program' => 'execute a one-line program from the command line',
                    '-e program' => 'alias for -E (execute one-line program)',
                    '-H'         => 'enter interactive help mode for exploring documentation',
                    '-i [file]'  => 'execute program in interactive mode (REPL)',
                    '-k'         => 'keep track of potentially incorrect parser interpretations',
                    '-M mode'    => ['set the rounding mode for floating-point numbers',
                                     'valid modes: [near], zero, inf, +inf, -inf, faith',
                                     '  near  = round to nearest (default)',
                                     '  zero  = round towards zero',
                                     '  inf   = round away from zero',
                                     '  +inf  = round towards positive infinity',
                                     '  -inf  = round towards negative infinity',
                                     '  faith = faithful rounding'],
                    '-N options' => ['configure Number class variables (semicolon-separated)',
                                     "example: 'VERBOSE=1; USE_YAFU=1; USE_PRIMECOUNT=1'",
                                     'available options: PREC, ROUND, VERBOSE, USE_YAFU,',
                                     '  USE_PFGW, USE_PARI_GP, USE_FACTORDB, USE_PRIMESUM,',
                                     '  USE_PRIMECOUNT, USE_CONJECTURES, SPECIAL_FACTORS'],
                    '-o file'    => 'specify output file for compiled/deparsed code',
                    '-O level'   => ['perform code optimizations before execution',
                                     'valid levels: [0], 1, 2',
                                     '  0 = no optimization (default)',
                                     '  1 = constant folding on AST (recommended)',
                                     '  2 = aggressive optimization with reparse'],
                    '-P int'     => 'set precision of floating-point numbers in bits',
                    '-r'         => 'parse and deparse program back to Sidef code',
                    '-R lang'    => ['parse and deparse program into specified language',
                                     'valid languages: sidef, perl'],
                    '-s'         => 'enable precompilation (cache compiled code)',
                    '-t'         => 'test mode: treat all arguments as script files',
                    '-v'         => 'display version information and exit',
                    '-w'         => 'enable warnings with stack backtrace',
                    '-W'         => 'make warnings fatal (with stack backtrace)',
    );
#>>>
    require File::Basename;
    my $basename = File::Basename::basename($0);

    print <<"HEADER";

Sidef Programming Language - Version $version

Usage: $basename [options] [--] [programfile] [arguments]

HEADER

    require List::Util;
    my $max_width = List::Util::max(map { length } keys %switches);
    $max_width += 4;

    foreach my $key (sort { lc($a) cmp lc($b) or lc($b) cmp lc($a) or $b cmp $a } keys %switches) {
        if (ref $switches{$key} eq 'ARRAY') {
            printf "  %-${max_width}s%s\n", $key, $switches{$key}[0];
            foreach my $i (1 .. $#{$switches{$key}}) {
                printf "  %-${max_width}s%s\n", '', $switches{$key}[$i];
            }
        }
        else {
            printf "  %-${max_width}s%s\n", $key, $switches{$key};
        }
    }

    print "\nRun '${basename}' without arguments to enter the interactive mode.\n\n";
}

sub VERSION_MESSAGE {
    print "$name $version\n";
}

sub read_script {
    my ($script_name) = @_;
    open my $fh, '<:utf8', $script_name
      or die qq{Can't open sidef script "$script_name": $!\n};
    local $/;
    <$fh>;
}

sub help_interactive {
    my ($term) = @_;

    require File::Spec;
    require File::Basename;

    require Encode;
    require Term::ReadLine;

    $term //= ($Sidef::Term::ReadLine //= Term::ReadLine->new("$name $version -- help interactive mode"));

    print <<"HELP";
Welcome to $name $version! This is the interactive help utility.

Enter the name of any object, keyword, or topic to get help on writing
$name programs and using $name modules.  To quit this help utility, just
type "quit".

Visit https://github.com/trizen/sidef for comprehensive documentation
and tutorials.

HELP

    my $sidef = Sidef->new(
                           name       => '-H',
                           opt        => {i           => 1, %args},
                           parser_opt => {interactive => 1},
                          );

    {
        my $line = Encode::decode_utf8(
            $term->readline('help> ')
              // do { print "\n"; return }
        );

        my $ccode = eval { $sidef->compile_code($line, 'Perl') };

        if ($@) {

            # Valid keywords for 'exit'
            if ($line eq 'quit' or $line eq 'q' or $line eq 'exit') {
                return;
            }

            # Otherwise, a syntax error
            warn $@;
            redo;
        }

        my @refs = (map { ref($_) } $sidef->execute_perl($ccode));

        foreach my $ref (@refs) {
            $ref eq '' && do { warn "Not an object!\n"; next };
            my $name = $ref =~ s{::}{/}gr;
            my $file = $INC{$name . '.pm'};
            my $pod;
            foreach my $dir (@INC) {
                if (-e (my $f = File::Spec->catfile($dir, $name . '.pod'))) {
                    $pod = $f;
                    last;
                }
            }
            if (defined($pod)) {
                system 'perldoc', $pod;
                $? && system 'man', $ref;
            }
            else {
                system 'man', $ref;
                $? && system 'perldoc', $ref;
            }
        }

        redo;
    }
}

#
## Interactive mode (REPL)
#
## The REPL reads one or more lines until the parser reports that the code is complete (like the
## Julia REPL), evaluates it, and prints the result as `#N = value`. The values can be reused with
## `#N` (or `#-1` for the last value). The declarations of the top-level (var, define, const, static)
## are global variables, which is done by the parser (see `repl_globals`), and the functions and the
## classes are kept by a persistent deparser (see `Sidef::compile_interactive`).
#

sub decode_input {
    my ($line) = @_;
    defined($line) or return;
    utf8::is_utf8($line) and return $line;    # already decoded (e.g.: by the :utf8 layer of STDIN)
    require Encode;
    return Encode::decode_utf8($line);
}

# The documentation of the objects (used by `help` and by `?expression`)
sub show_documentation {
    my (@refs) = @_;

    require File::Spec;

    foreach my $ref (@refs) {
        $ref eq '' && do { warn "Not an object!\n"; next };
        my $name = $ref =~ s{::}{/}gr;
        my $pod;
        foreach my $dir (@INC) {
            if (-e (my $f = File::Spec->catfile($dir, $name . '.pod'))) {
                $pod = $f;
                last;
            }
        }
        if (defined($pod)) {
            system 'perldoc', $pod;
            $? && system 'man', $ref;
        }
        else {
            system 'man', $ref;
            $? && system 'perldoc', $ref;
        }
    }

    return;
}

sub code_interactive {
    my $repl = Sidef::REPL->new(opt => \%args, name => $name, version => $version);
    $repl->run;
    return;
}

package Sidef::REPL {

    use utf8;
    use 5.016;
    use mro ();

    use constant {
                  PROMPT              => '> ',
                  CONTINUATION_PROMPT => '  ',
                  INDENT              => 4,
                  MAX_HISTORY         => 2000,
                 };

    # Words that are replaced with Unicode symbols, after pressing Tab: \alpha<Tab> => α
    sub _latex {
        state $table = {
            split(
                ' ', qq{
        alpha α beta β gamma γ delta δ epsilon ε zeta ζ eta η theta θ iota ι kappa κ lambda λ mu μ
        nu ν xi ξ omicron ο pi π rho ρ sigma σ tau τ upsilon υ phi φ chi χ psi ψ omega ω
        Gamma Γ Delta Δ Theta Θ Lambda Λ Xi Ξ Pi Π Sigma Σ Phi Φ Psi Ψ Omega Ω
        le ≤ leq ≤ ge ≥ geq ≥ ne ≠ neq ≠ equiv ≡ approx ≈ in ∈ notin ∉ ni ∋ subset ⊂ supset ⊃
        subseteq ⊆ supseteq ⊇ cup ∪ cap ∩ setminus ∖ emptyset ∅ infty ∞ sqrt √ pm ± mp ∓
        times × div ÷ cdot ⋅ circ ∘ sum ∑ prod ∏ partial ∂ nabla ∇ forall ∀ exists ∃ neg ¬
        land ∧ lor ∨ oplus ⊕ otimes ⊗ to → rightarrow → leftarrow ← Rightarrow ⇒ Leftarrow ⇐
        leftrightarrow ↔ ldots … cdots ⋯ degree ° propto ∝ angle ∠ int ∫ mid ∣ nmid ∤ star ⋆
        xor ⊻ ell ℓ hbar ℏ aleph ℵ
    }
                 )
        };
    }

    sub _commands {
        state $table = {map { $_ => 1 } qw(help reset quit exit q copyright license)};
    }

    sub new {
        my ($class, %opt) = @_;

        my $self = bless {
                          opt         => ($opt{opt} // {}),
                          name        => $opt{name},
                          version     => $opt{version},
                          valid_lines => [],
                          elapsed     => 0,
                          pending     => '',
                         }, $class;

        $self->{deparse_only} = (defined($self->{opt}{r}) or defined($self->{opt}{R}));
        $self->{tty}          = (-t STDIN) ? 1 : 0;

        return $self;
    }

    #
    ## The session
    #

    sub init_sidef {
        my ($self) = @_;

        @Sidef::HISTORY = ();
        $self->{valid_lines} = [];

        my $sidef = Sidef->new(
                               name       => '-i',
                               opt        => {i => 1, %{$self->{opt}}},
                               parser_opt => {
                                              interactive  => 1,
                                              repl_globals => ($self->{deparse_only} ? 0 : 1),
                                             },
                              );

        $self->{sidef} = $sidef;

        # Warm-up: loads the modules that are always required
        eval {
            my $ast = $sidef->parse_code('');
            $self->{deparse_only} or $sidef->execute_perl($sidef->compile_interactive($ast));
        };

        return $sidef;
    }

    sub run {
        my ($self) = @_;

        $self->init_sidef;
        $self->init_terminal;

        print <<"EOT";
Sidef $self->{version}, running on \u$^O, using Perl $^V.
Type "help", "copyright" or "license" for more information.
EOT

        if (@ARGV) {
            my $file = shift(@ARGV);
            $self->load_file($file);
        }

        while (defined(my $input = $self->read_input)) {
            $self->process($input);
        }

        return;
    }

    #
    ## The terminal
    #

    sub init_terminal {
        my ($self) = @_;

        $| = 1;    # the output must be in sync with the output of the terminal library

        require Encode;
        require Scalar::Util;
        require Term::ReadLine;
        require Time::HiRes;
        require File::Spec;

        my $name = "Sidef $self->{version} -- interactive mode";

        # The standard handles are given explicitly, which keeps the layers of STDIN and STDOUT (encoding)
        my $term = ($Sidef::Term::ReadLine //= Term::ReadLine->new($name, \*STDIN, \*STDOUT));

        $self->{term} = $term;
        $self->{impl} = eval { $term->ReadLine } // '';
        $self->{gnu}  = ($self->{impl} eq 'Term::ReadLine::Gnu');

        # Windows: use the encoding of the console (the default one is UTF-8)
        if ($^O eq 'MSWin32') {
            eval {
                require Win32;
                my $in  = Win32::GetConsoleCP();
                my $out = Win32::GetConsoleOutputCP();
                if ($in and $in != 65001) {
                    binmode(STDIN, ":raw:crlf:encoding(cp$in)");
                }
                if ($out and $out != 65001) {
                    binmode(STDOUT, ":raw:crlf:encoding(cp$out)");
                    binmode(STDERR, ":raw:crlf:encoding(cp$out)");
                }
            };
            eval { $term->ornaments(0) };    # no terminal capabilities
        }

        # The history entries are added by the REPL, after the code is complete (a multi-line input is one entry)
        eval { $term->MinLine(undef) };

        $self->{attr} = eval { $term->Attribs } || {};

        $self->init_history;
        $self->init_completion;

        return $term;
    }

    # The history file has one entry per line (the new lines of multi-line entries are stored as "\r")
    sub init_history {
        my ($self) = @_;

        my $term = $self->{term};

        $self->{history_file} = eval { File::Spec->catfile($self->{sidef}->get_sidef_config_dir, 'sidef_history.txt') };
        $self->{history_file} // return;

        if (-f $self->{history_file}) {
            if (open(my $fh, '<:utf8', $self->{history_file})) {
                my @lines = grep { /\S/ } map { chomp; $_ } <$fh>;
                close $fh;
                splice(@lines, 0, @lines - MAX_HISTORY) if @lines > MAX_HISTORY;

                if ($term->can('addhistory')) {
                    my $encode = $self->{gnu};
                    foreach my $line (@lines) {
                        $term->addhistory($encode ? Encode::encode_utf8($line) : $line);
                    }
                }
            }
        }

        return 1;
    }

    sub add_history {
        my ($self, $code) = @_;

        $code =~ /\S/ or return;

        my $entry = $code =~ s/\R/\r/gr;

        return if (defined($self->{last_entry}) and $self->{last_entry} eq $entry);
        $self->{last_entry} = $entry;

        my $term = $self->{term};

        if ($term->can('addhistory')) {
            $term->addhistory($self->{gnu} ? Encode::encode_utf8($entry) : $entry);
        }

        if (defined($self->{history_file}) and open(my $fh, '>>:utf8', $self->{history_file})) {
            print $fh $entry, "\n";
            close $fh;
        }

        return 1;
    }

    # Reads a line from the loaded file, or from the terminal. Returns undef at the end of the input.
    sub read_line {
        my ($self, $prompt, $preput, $first) = @_;

        # The lines of a file loaded with `# load`
        while (defined(my $fh = $self->{fh})) {

            if (defined(my $line = <$fh>)) {
                $line =~ s/\R\z//;

                # The rest of the file is the content of DATA
                if ($first and $line =~ /^\s*__(?:END|DATA)__\s*\z/) {
                    $line .= "\n" . do { local $/; <$fh> };
                }

                return $line;
            }

            close $fh;
            $self->{fh} = undef;
        }

        my $term = $self->{term};

        $self->{interrupted} = 0;

        my $line = do {
            ## local $SIG{INT} = sub { $self->{interrupted} = 1 };
            $self->{gnu} && defined($preput) && length($preput)
              ? $term->readline($prompt, $preput)
              : $term->readline($prompt);
        };

        if ($self->{interrupted}) {    # Ctrl-C: the pending input is discarded
            print "\n";
            return "\0INTERRUPT";
        }

        return ::decode_input($line);
    }

    #
    ## Reading the input
    #

    # Scans a piece of code: returns (the depth of the open brackets, the open quote or undef).
    # The strings and the comments are skipped.
    sub scan {
        my ($code) = @_;

        my $depth = 0;
        my $quote;

        pos($code) = 0;

        while (pos($code) < length($code)) {

            if (defined $quote) {
                $code =~ /\G(?:[^\\\Q$quote\E]++|\\.)/gcs and next;
                $code =~ /\G\Q$quote\E/gc                 and do { undef $quote; next };
                last;
            }

            $code =~ /\G#[^\n]*/gc    and next;
            $code =~ /\G([\[\{\(])/gc and do { ++$depth;               next };
            $code =~ /\G([\]\}\)])/gc and do { --$depth if $depth > 0; next };
            $code =~ /\G(["'`])/gc    and do { $quote = $1;            next };
            $code =~ /\G(?:\\.|[^\[\]\{\}\(\)"'`#\\]++|.)/gcs;
        }

        return ($depth, $quote);
    }

    # Is the name of a REPL command, which is not a declared variable?
    sub is_command {
        my ($self, $word) = @_;

        exists(_commands()->{$word}) or return 0;

        my $parser = $self->{sidef}{parser};
        return (defined($parser) and defined($parser->find_var($word, 'main'))) ? 0 : 1;
    }

    # Reads the next input: returns a hash-ref (`{code => ...}` or `{command => ...}`),
    # an empty hash-ref for an empty input, or undef at the end of the input.
    sub read_input {
        my ($self) = @_;

        my $buffer = '';
        my $lines  = 0;

        $self->{pending} = '';

      LINE: {

            my $indent = '';
            if ($lines and $self->{gnu} and ($ENV{SIDEF_REPL_INDENT} // 1)) {
                my ($depth) = scan($buffer);
                $indent = ' ' x (INDENT * $depth);
            }

            my $line = $self->read_line(($lines ? CONTINUATION_PROMPT : PROMPT), $indent, !$lines);

            if (not defined $line) {

                if ($buffer eq '') {
                    print "\n" if $self->{tty};
                    return;
                }

                # Ctrl-D inside an incomplete input: discard it (when reading from a pipe, report the error)
                if ($self->{tty}) {
                    print "\n";
                    return {};
                }

                my (undef, $error) = $self->parse($buffer);
                return {code => $buffer, error => ($error // "unexpected end of input\n")};
            }

            if ($line eq "\0INTERRUPT") {
                return {};
            }

            # History entries with several lines
            $line =~ s/\r\n?/\n/g;

            $buffer .= ($lines ? "\n" : '') . $line;
            ++$lines;
            $self->{pending} = $buffer;

            if ($buffer !~ /\S/) {
                return {} if $lines == 1;
                redo LINE;
            }

            # REPL commands
            if ($lines == 1) {
                if (defined(my $command = $self->parse_command($buffer))) {
                    return $command;
                }
            }

            # An explicit continuation of the line
            if ($buffer =~ /(?<!\\)\\\h*\z/) {
                redo LINE;
            }

            # The parser decides if the code is complete
            my ($ast, $error, $snapshot) = $self->parse($buffer);

            if (defined $error) {

                if (ref($error) and $error->{incomplete}) {
                    redo LINE;
                }

                return {error => $error, code => $buffer};
            }

            return {code => $buffer, ast => $ast, snapshot => $snapshot};
        }
    }

    sub parse_command {
        my ($self, $text) = @_;

        my $line = $text =~ s/^\s+|\s+\z//gr;

        if ($self->is_command($line)) {
            return {command => $line eq 'q' || $line eq 'exit' ? 'quit' : $line};
        }

        if ($line eq '##') {
            return {command => 'time'};
        }

        if ($line =~ /^#+\h*(load|exec|save)\h+(.+)/) {
            return {command => $1, argument => unpack('A*', $2)};
        }

        if ($line =~ /^\?\s*(.*)/s) {
            return {command => 'doc', argument => $1};
        }

        return;
    }

    # Parses the code. On error, the state of the parser is restored.
    # Returns: (AST, error, snapshot of the parser from before the parsing)
    sub parse {
        my ($self, $code) = @_;

        my $sidef  = $self->{sidef};
        my $parser = $sidef->{parser};

        my $snapshot = $parser->snapshot;
        $parser->{line} = 1;

        my $ast = eval { $sidef->parse_code($code) };

        if ($@) {
            my $error = $@;
            $parser->restore($snapshot);
            return (undef, $error);
        }

        return ($ast, undef, $snapshot);
    }

    #
    ## Evaluating the input
    #

    sub process {
        my ($self, $input) = @_;

        if (exists $input->{command}) {
            return $self->run_command($input);
        }

        exists($input->{code}) or return;

        my $code = $input->{code};

        $self->add_history($code);

        if (exists $input->{error}) {
            warn "$input->{error}";
            return;
        }

        $self->evaluate($code, $input->{ast}, $input->{snapshot});
    }

    sub evaluate {
        my ($self, $code, $ast, $snapshot) = @_;

        my $sidef = $self->{sidef};

        %{$ast} or return;    # only whitespace and comments

        # Deparse only
        if ($self->{deparse_only}) {
            my $lang     = $self->{opt}{r} ? 'Sidef' : ($self->{opt}{R} || 'Sidef');
            my $deparsed = eval { $sidef->compile_ast($ast, $lang) };
            if ($@) {
                $sidef->{parser}->restore($snapshot);
                warn $@;
                return;
            }
            push @{$self->{valid_lines}}, $code;
            ::output($deparsed);
            return;
        }

        my $perl = eval { $sidef->compile_interactive($ast) };

        if ($@) {
            my $error = $@;
            $sidef->{parser}->restore($snapshot);
            warn "[ERROR] Can't compile the code: $error";
            return;
        }

        push @{$self->{valid_lines}}, $code;

        my $t0 = eval { [Time::HiRes::gettimeofday()] };

        my @results = do {
            ## local $SIG{INT} = sub { die "Interrupted\n" };
            $sidef->execute_perl($perl);
        };

        my $error = $@;

        $self->{elapsed} = eval { Time::HiRes::tv_interval($t0) } // 0;

        if ($error) {
            $sidef->rollback_interactive;
            print STDERR (ref($error) ? "$error" : $error);
            return;
        }

        @results or return;

        push @Sidef::HISTORY, \@results;

        # A trailing semicolon hides the result (as in Julia)
        $code =~ /;\s*\z/ and return;

        my @dump = map { $self->dump_value($_) } @results;
        my $dump = (@dump > 1 ? '(' . join(', ', @dump) . ')' : $dump[0]);

        say "#" . scalar(@Sidef::HISTORY) . " = $dump";

        return 1;
    }

    sub dump_value {
        my ($self, $value) = @_;

        my $str = eval { ref($value) ? (UNIVERSAL::can($value, 'dump') ? $value->dump : "$value") : ($value // 'nil'); };

        defined($str) or return '<error: ' . (split(/\n/, "$@"))[0] . '>';

        # Floating-point numbers
        if (    ref($value) eq 'Sidef::Types::Number::Number'
            and ref($$value) eq 'Math::MPFR'
            and Math::MPFR::Rmpfr_number_p($$value)) {
            $str .= 'f';
        }

        return $str;
    }

    #
    ## The REPL commands
    #

    sub run_command {
        my ($self, $input) = @_;

        my $command  = $input->{command};
        my $argument = $input->{argument};

        if ($command eq 'quit') {
            exit 0;
        }

        if ($command eq 'help') {
            ::help_interactive($self->{term});
            return;
        }

        if ($command eq 'doc') {
            return $self->show_help($argument);
        }

        if ($command eq 'reset') {
            $self->init_sidef;
            return;
        }

        if ($command eq 'time') {
            say "  ***   last result computed in $self->{elapsed} seconds";
            return;
        }

        if ($command eq 'load') {
            $self->load_file($argument);
            return;
        }

        if ($command eq 'exec') {
            open(my $fh, '<:utf8', $argument) or do {
                warn "Can't open file <<$argument>> for reading: $!\n";
                return;
            };
            my $content = do { local $/; <$fh> };
            close $fh;

            my ($ast, $error, $snapshot) = $self->parse($content);

            if (defined $error) {
                warn "$error";
                return;
            }

            $self->evaluate($content, $ast, $snapshot);
            return;
        }

        if ($command eq 'save') {
            open(my $fh, '>:utf8', $argument) or do {
                warn "Can't open file <<$argument>> for writing: $!\n";
                return;
            };
            print $fh map { "$_\n" } @{$self->{valid_lines}};
            close $fh;
            say "** Created file: $argument";
            return;
        }

        if ($command eq 'copyright') {
            print <<'EOT';
Copyright © 2013-2026 Daniel Șuteu, Ioana Fălcușan
All Rights Reserved.
EOT
            return;
        }

        if ($command eq 'license') {
            print <<'EOT';

This program is free software; you can redistribute it
and/or modify it under the terms of the Artistic License (2.0).
For more details, see the full text in the LICENSE file.

This program is distributed in the hope that it will be
useful, but without any warranty; without even the implied
warranty of merchantability or fitness for a particular purpose.

For more information, see:
    https://github.com/trizen/sidef
    https://www.perlfoundation.org/artistic-license-20.html

EOT
            return;
        }

        return;
    }

    sub load_file {
        my ($self, $file) = @_;

        open(my $fh, '<:utf8', $file) or do {
            warn "Can't open file <<$file>> for reading: $!\n";
            return;
        };

        $self->{fh} = $fh;
        return 1;
    }

    # `?expression` shows the documentation of the class of the values of the expression
    sub show_help {
        my ($self, $expr) = @_;

        if ($expr !~ /\S/) {
            ::help_interactive($self->{term});
            return;
        }

        my $sidef = $self->{sidef};

        my ($ast, $error, $snapshot) = $self->parse($expr);

        if (defined $error) {
            warn "$error";
            return;
        }

        my $perl = eval { $sidef->compile_interactive($ast) };

        if ($@) {
            $sidef->{parser}->restore($snapshot);
            warn $@;
            return;
        }

        my @refs = map { ref($_) } $sidef->execute_perl($perl);

        if ($@) {
            $sidef->rollback_interactive;
            print STDERR $@;
            return;
        }

        ::show_documentation(@refs);
        return;
    }

    #
    ## Auto-completion
    #

    sub init_completion {
        my ($self) = @_;

        my $term = $self->{term};
        my $attr = $self->{attr};

        (Scalar::Util::reftype($attr) // '') eq 'HASH' or return;

        # The characters that end a word
        $attr->{completer_word_break_characters} = qq{ \t\n"'`\@\$><=;|&{}()[]+*%^~!,?.};
        $attr->{basic_quote_characters}          = q{};
        $attr->{completer_quote_characters}      = q{};
        $attr->{completion_append_character}     = q{};

        if ($self->{gnu}) {

            # Ctrl-C: makes the call of readline() return, when the signal was received
            $attr->{event_hook} = sub {    # this is buggy
                if ($self->{interrupted}) {
                    $attr->{line_buffer} = '';
                    $attr->{done}        = 1;
                }
                return 0;
              }
              if 0;

            $attr->{attempted_completion_function} = sub {
                my ($text, $line, $start, $end) = @_;

                my $result = eval { $self->complete(Encode::decode_utf8($text), Encode::decode_utf8(substr(Encode::encode_utf8($line), 0, $start))) };

                # An error in the completion must never break the session
                if ($@) {
                    $attr->{attempted_completion_over} = 1;
                    return;
                }

                defined($result) or return;    # file names

                if (not @{$result}) {
                    $attr->{attempted_completion_over} = 1;
                    return;
                }

                my @list = map { Encode::encode_utf8($_) } @{$result};

                return $term->completion_matches($text, sub { my ($t, $state) = @_; $list[$state] });
            };
        }
        else {
            $attr->{completion_function} = sub {
                my ($text, $line, $start) = @_;
                my $result = eval { $self->complete($text, substr($line, 0, $start)) };
                return (ref($result) ? @{$result} : ());
            };
        }

        return 1;
    }

    # The methods of a class, including the inherited ones
    sub class_methods {
        my ($class) = @_;

        my %seen;

        # The types are loaded on demand
        if (index($class, 'Sidef::') == 0) {
            eval { require($class =~ s{::}{/}gr . '.pm') };
        }

        no strict 'refs';

        foreach my $pkg (@{mro::get_linear_isa($class)}) {
            foreach my $name (keys %{$pkg . '::'}) {
                $name =~ /\A[^\W\d]\w*\z/ or next;
                $name =~ /\A_|\A[A-Z0-9]+\z|\A(?:BEGIN|END|DESTROY|AUTOLOAD|import|unimport|isa|can|DOES|VERSION)\z/ and next;
                defined(&{$pkg . '::' . $name}) or next;
                $seen{$name} = 1;
            }
        }

        return keys %seen;
    }

    # The methods of all the loaded types
    sub all_methods {
        my ($self) = @_;

        my $count = scalar(keys %INC);

        if (($self->{all_methods_count} // -1) != $count) {

            my %seen;
            foreach my $module (keys %INC) {
                $module =~ /\ASidef\/Types\/.*\.pm\z/ or next;
                my $class = $module =~ s{\.pm\z}{}r =~ s{/}{::}gr;
                @seen{class_methods($class)} = ();
            }

            $self->{all_methods}       = [keys %seen];
            $self->{all_methods_count} = $count;
        }

        return @{$self->{all_methods}};
    }

    # The methods that can be called on the expression that precedes a dot
    sub receiver_methods {
        my ($self, $receiver) = @_;

        $receiver =~ s/\s+\z//;

        my $parser = $self->{sidef}{parser};
        my $class;

        if ($receiver =~ /(?<![.\w:])([^\W\d]\w*(?:::[^\W\d]\w*)*)\z/) {
            my $name = $1;

            if (defined(my $var = $parser->find_var($name =~ /^(.*)::(.*)$/ ? ($2, $1) : ($name, 'main')))) {

                if ($var->{type} eq 'global') {
                    my $value = eval { no strict 'refs'; ${$var->{obj}{class} . '::' . $var->{obj}{name}} };
                    $class = ref($value) if ref($value);
                }
                elsif ($var->{type} eq 'func' or $var->{type} eq 'method') {
                    $class = 'Sidef::Types::Block::Block';
                }
            }
            elsif (exists $parser->{built_in_classes}{$name}) {
                my $code = $name;
                my $obj  = eval { $parser->parse_expr(code => \$code) };
                if (ref($obj) and not $@) {
                    $class = ref($obj) =~ s/\ASidef::DataTypes::/Sidef::Types::/r;
                    eval { require($class =~ s{::}{/}gr . '.pm') };
                }
            }
        }
        elsif ($receiver =~ /["'`]\z/) {
            $class = 'Sidef::Types::String::String';
        }
        elsif ($receiver =~ /(?<![\w.])\d[\d_]*(?:\.\d+)?\z/) {
            $class = 'Sidef::Types::Number::Number';
        }
        elsif ($receiver =~ /\]\z/) {
            $class = 'Sidef::Types::Array::Array';
        }

        if (defined($class) and $class !~ /\A(?:Sidef::Variable|Sidef::Meta)::/) {
            my @methods = class_methods($class);
            return @methods if @methods;
        }

        return $self->all_methods;
    }

    # The names that are visible in the current scope
    sub declared_names {
        my ($self, $namespace) = @_;

        my $parser = $self->{sidef}{parser};

        my %seen;
        my @scopes = ($parser->{vars}{$namespace} // [], @{$parser->{ref_vars_refs}{$namespace} // []});

        foreach my $scope (@scopes) {
            foreach my $entry (@{$scope}) {
                ref($entry) eq 'HASH' or next;
                my $name = $entry->{name} // next;
                length($name) and $name !~ /\A__ANON__/ and $seen{$name} = 1;
            }
        }

        return keys %seen;
    }

    sub file_candidates {
        my ($prefix) = @_;

        my ($dir, $base) = $prefix =~ m{\A(.*/)?([^/]*)\z}s;
        $dir //= '';

        opendir(my $dh, ($dir eq '' ? '.' : $dir)) or return;

        my @files;
        foreach my $file (readdir($dh)) {
            next if ($file eq '.' or $file eq '..');
            next if index($file, $base) != 0;
            next if (substr($file, 0, 1) eq '.' and substr($base, 0, 1) ne '.');
            my $path = $dir . $file;
            push @files, $path . (-d $path ? '/' : '');
        }

        closedir($dh);
        return sort @files;
    }

    # Returns an array-ref with the possible completions of $text (a list of words that start with $text),
    # or undef to let the terminal complete a file name.
    # $before is the text of the line that precedes $text.
    sub complete {
        my ($self, $text, $before) = @_;

        my $context = $self->{pending} . (length($self->{pending}) ? "\n" : '') . $before;

        my ($depth, $quote) = scan($context);

        # Inside a string: file names
        if (defined $quote) {

            # The content of the string, until the cursor (approximately)
            my $content = $context           =~ s/\A.*\Q$quote\E//sr;
            my $prefix  = ($content . $text) =~ s/\A.*\n//sr;

            my @files = file_candidates($prefix) or return [];

            # The completions replace $text only
            my $keep = length($prefix) - length($text);
            return [map { substr($_, $keep) } grep { length($_) >= $keep } @files];
        }

        # The word at the end of $text
        my ($root, $word);

        if ($text =~ /\A(.*?)(\\[A-Za-z0-9^_]*)\z/s) {
            ($root, $word) = ($1, $2);
        }
        else {
            ($text =~ /\A(.*?)([\w:]*)\z/s);
            ($root, $word) = ($1, $2);
        }

        my $left = $before . $root;

        my @candidates;

        if (substr($word, 0, 1) eq '\\') {
            my $name = substr($word, 1);

            if (exists _latex()->{$name}) {
                return [$root . _latex()->{$name}];
            }

            @candidates = map { "\\$_" } keys %{_latex()};
        }
        elsif ($left =~ /\.\.\z/) {
            return [];
        }
        elsif ($left =~ /\.\h*\z/) {
            @candidates = $self->receiver_methods(substr($left, 0, rindex($left, '.')));
        }
        elsif ($left =~ /::\z/ and $word !~ /::/) {
            @candidates = $self->all_methods;
        }
        elsif ($left =~ /\b(?:var|global|const|define|static|func|class|method|enum|struct|subset|module|has|del)\h+\z/) {
            return [];
        }
        elsif ($word =~ /\A(.+)::([^:]*)\z/) {
            my $namespace = $1;
            @candidates = map { "${namespace}::$_" } $self->declared_names($namespace);
        }
        else {
            my $parser = $self->{sidef}{parser};

            @candidates = ($self->declared_names('main'), grep { index($_, '__') != 0 } keys %{$parser->{special_words}});

            # The functional style: name(...)
            length($word) and push @candidates, $self->all_methods;

            # REPL commands, at the beginning of the line
            if ($left =~ /\A\s*\z/ and not length($self->{pending})) {
                push @candidates, keys %{_commands()};
            }
        }

        my %seen;
        my @result = sort grep { !$seen{$_}++ and index($_, $word) == 0 } @candidates;

        return [map { $root . $_ } @result];
    }
}

sub _get_loaded_modules {
    my @modules;
    foreach my $key (sort { length($a) <=> length($b) || $a cmp $b } keys %INC) {
        if ($key =~ /^(Sidef\b.*)\.pm\z/) {
            push @modules, $1 =~ s{/}{::}gr;
        }
    }
    return @modules;
}

sub output {
    my ($content) = @_;

    my $out_fh = \*STDOUT;

    if (defined $args{o}) {
        open $out_fh, '>:utf8', $args{o}
          or die "Can't open file '$args{o}' for write: $!\n";
    }
    print {$out_fh} $content;

    return $out_fh;
}

sub dump_ast {
    my ($ast) = @_;

    eval { require Data::Dump };

    if ($@) {
        die qq{** "Data::Dump" is not installed!\n};
    }
    else {
        my $out_fh = output('');

        my $requirify = sub {
            join('', map { "require '" . (s{::}{/}gr) . ".pm';\n" } @_);
        };

        print {$out_fh} $requirify->(_get_loaded_modules());
        print {$out_fh} Data::Dump::pp($ast) . "\n";
    }
}

sub compile_to_perl {
    my (%opt) = @_;

    require File::Spec;
    require File::Basename;

    my $path = File::Spec->catdir(File::Basename::dirname($INC{'Sidef.pm'}), 'Sidef');

    my $package_content = <<"HEAD";
#!$^X

eval 'exec $^X  -S \$0 \${1+"\$@"}'
    if 0; # not running under some shell

use utf8;

binmode STDIN,  ":utf8";
binmode STDOUT, ":utf8";
binmode STDERR, ":utf8" if \$^P == 0;    # to work under Devel::* modules

my %REQ;
my %MODULE;
HEAD

    $package_content .= "BEGIN { %MODULE = (\n";

    require File::Find;
    File::Find::find(
        {
         no_chdir => 1,
         wanted   => sub {
             if (/\.pm\z/ and -f) {

                 local $/;
                 open my $fh, '<:utf8', $_
                   or die "Can't open file `$_` for reading: $!";

                 my $token   = tr/A-Za-z0-9/_/cr;
                 my $content = <$fh>;

                 if ($content =~ /^package\h+([\w:]+)/) {
                     $package_content .= qq{'${1}' => };
                 }
                 else {
                     die qq{ERROR: can't get the package name from file `$_`};
                 }

                 $package_content .= qq{<<'${token}',\n};
                 $package_content .= $content;
                 $package_content .= "\n$token\n";

                 close $fh;
             }
         }
        } => ($path, $INC{'Sidef.pm'})
    );

    $package_content .= <<'FOOT';
);

sub __load_sidef_module__ {
    my ($name) = @_;
    if (not exists $REQ{$name}) {
        my $module = $name =~ s{::}{/}gr . '.pm';
        if (exists $MODULE{$name} and not exists $INC{$module}) {

            # Load the Sidef used modules
            $MODULE{$name} =~ s{^\h*
                  use \h+ (?:
                      parent \s+ qw\((.*?)\)
                    | (Sidef::[\w:]+)
                  )
            }{
                  join(
                  ";\n" => map{
                    exists($REQ{$_})
                        ? ()
                        : "BEGIN{ main::__load_sidef_module__('${_}') }" } split(' ', $+)
                  ) . (defined($1) ? "\nuse parent qw(-norequire $1);\n" : '')
            }gxmse;

            $INC{$module} = 1;
            eval($MODULE{$name});
            die "[FATAL ERROR] Can't load `$module`: $@" if $@;
        }
        else {
            require $module;
        }
        $REQ{$name} = 1;
    }
    return 1;
}

FOOT

    my $requirify = sub {
        join('', map { "__load_sidef_module__('${_}');\n" } grep { $_ ne 'Sidef::Optimizer' } @_);
    };

    $package_content .= $requirify->(_get_loaded_modules(), 'Sidef::Module::OO', 'Sidef::Module::Func');

    my @used_pkgs;
    while ($opt{code} =~ /^use (Sidef::\S+);$/gm) {
        push @used_pkgs, $1;
    }

    $package_content .= $requirify->(@used_pkgs) if @used_pkgs;
    $package_content .= "}\n\n";

    my $out_fh = output('');
    print {$out_fh} $package_content;
    print {$out_fh} $opt{code};
}

__END__

=encoding utf8

=head1 NAME

sidef - The Sidef Programming Language interpreter

=head1 SYNOPSIS

    sidef [options] [--] [programfile] [arguments]

    # Execute a Sidef script
    sidef script.sf

    # Enter interactive mode (REPL)
    sidef
    sidef -i

    # Execute a Sidef script in interactive mode
    sidef -i script.sf

    # Execute one-line program
    sidef -E '10.of { |i| say i**2 }'

    # Check syntax without execution
    sidef -C script.sf

    # Compile to stand-alone Perl program
    sidef -c -o output.pl script.sf

    # Set floating-point precision to 100 digits
    sidef -P 400 -E 'say sqrt(2)'

    # Enable optimizations
    sidef -O1 script.sf

    # Parse and display as Sidef code
    sidef -r script.sf

    # Deparse to Perl code
    sidef -Rperl script.sf

=head2 INTERACTIVE MODE (REPL)

Run 'sidef' without arguments to enter the interactive mode.

Special REPL commands:

     ##                - show execution time of last command
     #n                - refer to nth output value (e.g., #1, #-1)
     ?expr             - show the documentation of the value of expr
     # load file.sf    - load and execute file line by line
     # exec file.sf    - execute entire file
     # save file.sf    - save REPL session to file
     reset             - reset the REPL environment
     quit, exit, q     - exit REPL
     help              - display interactive help
     copyright         - show copyright information
     license           - show license information

=head1 DESCRIPTION

Sidef is a modern, high-level programming language designed for writing elegant and expressive code. This is the main interpreter for executing Sidef programs, providing both script execution and an interactive Read-Eval-Print Loop (REPL) environment.

Sidef features arbitrary-precision arithmetic, functional programming constructs, object-oriented programming, powerful regex support, and extensive built-in methods for common tasks. The language emphasizes code readability and expressiveness while maintaining strong performance through optimization and optional precompilation.

=head1 INSTALLATION

=head2 From CPAN

    cpan Sidef
    cpanm Sidef

=head2 From Source

    git clone https://github.com/trizen/sidef.git
    cd sidef
    perl Makefile.PL
    make
    make test
    make install

=head2 Dependencies

Sidef requires Perl 5.16 or later, and depends on several CPAN modules including Math::GMPz, Math::GMPq, Math::MPFR, and Math::MPC for arbitrary-precision arithmetic. The installation process will automatically resolve and install these dependencies.

=head1 LANGUAGE OVERVIEW

=head2 Objects and Method Chaining

Everything in Sidef is an object. Methods can be chained fluently:

    [1,2,3,4,5].grep{ .is_prime }.map{ _ ** 2 }.say

=head2 Arbitrary-Precision Numbers

Sidef supports integers, rationals, floats, and complex numbers with arbitrary precision:

    say 2**1000            # exact large integer
    say 355/113            # rational, stored exactly
    say sqrt(2.0)          # arbitrary-precision float
    say (1 + 2i)           # complex arithmetic

=head2 Functional Programming

Closures, higher-order functions, and lazy evaluation are built in:

    var add = func(x) { func(y) { x + y } }
    say add(3)(4)          # 7

    [1..10].lazy.grep{ .is_prime }.first(3).say

=head2 Object-Oriented Programming

Classes with inheritance and method overloading:

    class Animal(name) {
        method speak { "..." }
    }
    class Dog(name) < Animal(name) {
        method speak { "Woof, I am #{name}!" }
    }
    say Dog("Rex").speak

=head2 Regular Expressions and String Interpolation

    var str = "Hello, World!"
    say str.gsub(/[aeiou]/i, "*")   # replace vowels
    say "1 + 1 = #{1 + 1}"          # string interpolation

=head2 Built-in Collections

Arrays, hashes, sets, and ranges are native types:

    var h = Hash(a => 1, b => 2)
    say h{:a}
    say (1..100 -> sum)

=head2 Number Theory

An extensive library of number theory functions is built in:

    say 12.factor           # [2, 2, 3]
    say 1000.nth_prime      # 7919
    say prime_count(10**6)  # 78498

=head2 Unicode Support

Sidef supports Unicode throughout — identifiers, strings, and I/O:

    var π = Num.pi
    say "π ≈ #{π}"

=head1 OPTIONS

=head2 Execution Options

=over 4

=item B<-E> I<program>

Execute a one-line program from the command line. The program is executed immediately without requiring a file. This is useful for quick calculations, text processing, or testing code snippets.

    sidef -E 'say "Hello, World!"'
    sidef -E '10.times { |i| say i**2 }'
    sidef -E '[1,2,3,4,5].grep{.is_prime}.say'

=item B<-e> I<program>

Alias for B<-E>. Execute a one-line program.

=item B<-i> [I<file>]

Enter interactive mode (REPL - Read-Eval-Print Loop). If a file is provided, its contents are loaded and executed line by line in the interactive session. The REPL provides immediate feedback, command history, tab completion, and persistent variable state throughout the session.

    sidef -i                    # Start empty REPL
    sidef -i startup.sf         # Load file into REPL
    sidef -i < commands.txt     # Pipe commands

=item B<-t>

Test mode. Treat all command-line arguments as script files and execute them sequentially. Useful for running test suites. Reports which scripts succeed or fail and provides a summary at the end.

    sidef -t test1.sf test2.sf test3.sf
    sidef -t tests/*.sf

=item B<-->

End of options marker. Everything after this is treated as a program file or arguments, even if it starts with a dash. Useful when script names begin with hyphens.

    sidef -- -weird-script-name.sf

=back

=head2 Compilation and Analysis Options

=over 4

=item B<-c>

Compile the Sidef code into a stand-alone Perl program. The output includes all necessary Sidef runtime modules embedded in a single file, making it distributable without requiring a Sidef installation. The resulting program can be executed directly with Perl.

    sidef -c -o myprogram.pl script.sf
    chmod +x myprogram.pl
    ./myprogram.pl

Note: Code using C<eval()> may not compile correctly as it requires parse-time information that is lost during compilation.

=item B<-C>

Check syntax only. Parse the program and report any syntax errors without executing the code. Useful for validating code structure before deployment or as part of a continuous integration pipeline.

    sidef -C script.sf
    sidef -C *.sf               # Check all scripts

=item B<-D>

Dump the Abstract Syntax Tree (AST) of the program. The AST represents the internal structure of the parsed program before execution. Useful for debugging parser behavior, understanding how code is interpreted, and developing language extensions.

    sidef -D script.sf > ast.dump
    sidef -D -E '1 + (2 * 3)' | less

Requires the C<Data::Dump> Perl module.

=item B<-r>

Parse and deparse the program back to Sidef code. This shows how the parser interpreted your code and can help identify parsing ambiguities, verify operator precedence, and understand method call transformations.

    sidef -r script.sf
    sidef -r -E '1 + 2/3'       # Shows: (1)->+((2)->/(3));

=item B<-R> I<language>

Parse and deparse the program into the specified target language. This translates Sidef code into equivalent code in another language while preserving semantics. Valid values are:

=over 8

=item * B<sidef> - Deparse to Sidef code (same as -r)

=item * B<perl> - Translate to Perl code with Sidef runtime

=back

    sidef -Rperl script.sf > script.pl
    perl script.pl

    sidef -Rsidef script.sf    # Normalize code style

=back

=head2 Optimization Options

=over 4

=item B<-O> I<level>

Perform code optimizations before execution. Higher optimization levels can significantly improve runtime performance for computation-heavy scripts by evaluating constant expressions at compile time. Valid levels:

=over 8

=item * B<0> - No optimization (default). Code is executed as parsed.

=item * B<1> - Constant folding on AST (recommended for production). Pure expressions with constant operands are evaluated at compile time, reducing runtime computation.

=item * B<2> - Aggressive optimization with deparse and reparse. Performs constant folding, deparses to Sidef code, reparses, and does additional constant folding on the new AST. Increases compile time but may provide additional optimizations.

=back

    sidef -O0 script.sf         # Default, no optimization
    sidef -O1 script.sf         # Recommended
    sidef -O2 compute.sf        # Maximum optimization

Example optimization:

    # Source code
    var x = (2 + 3*4)

    # After -O1 optimization
    var x = 14

=item B<-s>

Enable precompilation caching. Compiled code is saved in a database indexed by MD5 hash of the source code. On subsequent runs of the same code, the compiled version is loaded from cache, significantly reducing startup time for large programs.

    sidef -s large_script.sf    # Slow first run (compiles and caches)
    sidef -s large_script.sf    # Fast subsequent runs (loads from cache)

The cache is automatically maintained and periodically sanitized. Cache location: C<~/.sidef/cache/>

=back

=head2 Number Configuration Options

Sidef provides arbitrary-precision arithmetic through the GMP and MPFR libraries. These options control precision and behavior of numeric operations.

=over 4

=item B<-P> I<precision>

Set the precision of floating-point numbers as approximately the number of decimal digits. Internally the value is converted to bits (multiplied by approximately 3.32), so C<-P 50> gives roughly 50 decimal digits of precision. Higher precision allows more accurate calculations but increases memory usage and computation time. Default is approximately 58 decimal digits (192 bits).

    sidef -P 50 -E 'say sqrt(2)'          # ~50 decimal digits
    sidef -P 100 -E 'say sqrt(2)'         # ~100 decimal digits
    sidef -P 1000 -E 'say Num.pi'         # ~1000 decimal digits

=item B<-M> I<mode>

Set the rounding mode for floating-point operations. Different rounding modes are useful for different numerical applications (financial calculations, scientific computing, interval arithmetic, etc.). Valid modes:

=over 8

=item * B<near> - Round to nearest (default). Standard rounding mode.

=item * B<zero> - Round towards zero (truncate). Discards fractional part.

=item * B<inf> - Round away from zero. Rounds up for positive, down for negative.

=item * B<+inf> - Round towards positive infinity (ceiling). Always rounds up.

=item * B<-inf> - Round towards negative infinity (floor). Always rounds down.

=item * B<faith> - Faithful rounding. Result is one of the two nearest floating-point numbers.

=back

    sidef -M near -E 'say 7/3'            # 2.333... (nearest)
    sidef -M zero -E 'say 7/3'            # 2.333... (towards zero)
    sidef -M +inf -E 'say 7/3'            # 2.334... (ceiling)
    sidef -M -inf -E 'say 7/3'            # 2.333... (floor)

=item B<-N> I<options>

Configure Number class variables for fine-grained control over numeric computation behavior. Multiple options can be separated by semicolons. Format: C<'NAME1=VALUE1; NAME2=VALUE2'>

Available options:

=over 8

=item * B<PREC> - Floating-point precision in decimal digits (same as -P)

=item * B<ROUND> - Rounding mode as integer: 0=near, 1=zero, 2=inf, 3=+inf, 4=-inf, 5=faith

=item * B<VERBOSE> - Enable verbose/debug mode (true/false). Prints detailed information about numeric operations.

=item * B<USE_YAFU> - Use YAFU (Yet Another Factorization Utility) for factoring large integers (true/false). Requires YAFU installed.

=item * B<USE_PFGW> - Use PFGW64 (PrimeForm/GW) as a primality pretest for large numbers (true/false). Requires PFGW64 installed.

=item * B<USE_PARI_GP> - Use PARI/GP for various number theory operations (true/false). Requires PARI/GP installed.

=item * B<USE_FACTORDB> - Use factordb.com web service for factoring large integers (true/false). Requires internet connection.

=item * B<USE_PRIMESUM> - Use Kim Walisch's primesum for computing sum of primes (true/false). Requires primesum installed.

=item * B<USE_PRIMECOUNT> - Use Kim Walisch's primecount for computing prime counting function π(n) (true/false). Requires primecount installed.

=item * B<USE_CONJECTURES> - Use conjectured (unproven but likely correct) methods for better performance (true/false).

=item * B<SPECIAL_FACTORS> - Try to find factors of special form (Fermat, Mersenne, etc.) when factoring (true/false).

=back

Examples:

    # Enable verbose mode and external factorization
    sidef -N 'VERBOSE=true; USE_FACTORDB=true' -E 'say factor(2**512 + 1)'

    # High precision with specific rounding
    sidef -N 'PREC=400; ROUND=3' script.sf

    # Use all available external tools
    sidef -N 'USE_YAFU=true; USE_PARI_GP=true; USE_PRIMECOUNT=true' script.sf

=back

=head2 Debugging and Warning Options

=over 4

=item B<-k>

Keep track of potentially incorrect parser interpretations. Enables warnings when the parser makes assumptions that might not match your intent. This is especially useful for catching typos in function names that get interpreted as method calls.

    sidef -k script.sf

Example warning:

    func foo(n) { say n }
    fo(42)                      # Typo in function name

    # With -k:
    [INFO] `fo` is parsed as a prefix method-call at script.sf line 2

Common cases flagged:

=over 8

=item * Method calls without an explicit receiver

=item * Ambiguous operator precedence interpretations

=item * Potential variable/function name confusion

=back

=item B<-w>

Enable warnings with stack backtrace. When a warning occurs, displays a complete call stack showing the sequence of function/method calls that led to the warning. Useful for debugging complex code paths.

=item B<-W>

Make warnings fatal (with stack backtrace). The program terminates immediately on the first warning, showing a full stack trace. This is useful for strict error checking during development or testing.

=back

=head2 Output Options

=over 4

=item B<-o> I<file>

Specify output file for compiled or deparsed code. By default, output goes to STDOUT. This option is typically used with B<-c>, B<-r>, or B<-R>.

    sidef -c -o program.pl script.sf        # Compile to file
    sidef -R perl -o script.pl script.sf    # Deparse to file
    sidef -D -o ast.txt script.sf           # Dump AST to file

=back

=head2 Information Options

=over 4

=item B<-H>

Enter interactive help mode. Provides access to documentation for Sidef objects, methods, and modules. You can enter any expression that evaluates to an object, and the help system will display its documentation.

    sidef -H
    help> Array()
    help> Hash()
    help> Number()
    help> quit

=item B<-h>

Display help message with usage information and available options, then exit.

=item B<-v>

Print version information and exit. Shows the Sidef version number.

=back

=head1 INTERACTIVE MODE (REPL)

When invoked without a script file, Sidef enters interactive mode, providing a Read-Eval-Print Loop (REPL) for exploring the language, testing code snippets, and rapid prototyping.

=head2 Starting the REPL

    $ sidef
    Sidef 26.09, running on Linux, using Perl v5.42.1.
    Type "help", "copyright" or "license" for more information.
    >

Or explicitly with the C<-i> option:

    $ sidef -i
    $ sidef -i startup.sf       # Load file first

=head2 REPL Features

=over 4

=item * B<Persistent Variables>

All variables, functions, and classes defined in the REPL persist throughout the session.
The declarations from the top-level (C<var>, C<define>, C<const>, C<static>) are turned into global variables by the parser,
which makes them visible in the next lines. The declarations inside blocks remain lexical.

    > var x = 42
    #1 = 42
    > var y = (x + 10)
    #2 = 52
    > func double(n) { n * 2 }
    > double(x)
    #3 = 84

=item * B<Result History>

Every expression result is stored and can be referenced using C<#n> notation, where C<n> is the result number. Negative indices count from the end.

    > 3 + 4
    #1 = 7
    > #1 * 2                    # Reference first result
    #2 = 14
    > #-1                       # Last result (same as #2)
    #3 = 14

=item * B<Multiline Input>

Like in the Julia REPL, the line is evaluated as soon as the code is complete. When the parser reaches the end of the input
inside a block, a bracket, a string, a here-document, or after an operator, the REPL reads the next line
(the prompt changes from C<E<gt>> to C<  >), indented by the current depth of the brackets.
A line that ends with a backslash (C<\>) is also continued on the next line.
Press Ctrl-C to discard the incomplete input. A trailing semicolon hides the result, and a syntax error that is not caused
by an incomplete input is reported immediately.

    > func factorial(n) {
        n == 0 ? 1 : n*factorial(n-1)
      }
    > factorial(10)
    #2 = 3628800

=item * B<Tab Completion>

Press Tab to complete the names that are visible in the current scope, the keywords, the built-in classes and the REPL commands.
After a dot, the methods of the value of the variable (or of the class, or of the literal) are completed.
Inside a string, file names are completed. LaTeX-like names are replaced with Unicode symbols (C<\pi> becomes C<π>,
C<\le> becomes C<≤>). The completion requires L<Term::ReadLine::Gnu>.

On Windows, when only the stub of L<Term::ReadLine> is available, the REPL works without completion and line editing
(the editing and the history of the console are used).

=item * B<Command History>

Use Up/Down arrow keys to navigate previous commands. A multi-line input is a single entry of the history.
History persists between sessions (saved to C<sidef_history.txt>, in the configuration directory of Sidef).

=back

=head2 Special REPL Commands

=over 4

=item B<##>

Display execution time of the last command. Useful for benchmarking and performance analysis.

    > factor(2**128 + 1)
    #1 = [59649589127497217, 5704689200685129054721]
    > ##
      ***   last result computed in 0.364332 seconds

=item B<# load> I<filename>

Load and execute a Sidef file line by line in the REPL. Each line is executed as if typed into the REPL.

    > # load mylib.sf

=item B<# exec> I<filename>

Execute an entire Sidef file in the current REPL session. Unlike C<# load>, this executes the file as a complete unit, but within the REPL environment, where the variables persist.

    > # exec script.sf

=item B<# save> I<filename>

Save all valid commands from the REPL session to a file. This creates a replayable script containing all successfully executed code.

    > # save session.sf
    ** Created file: session.sf

=item B<reset>

Reset the REPL environment, clearing all variables, functions, and definitions. Result history is also cleared.

=item B<help>

Enter interactive help mode to explore documentation.

=item B<copyright>

Display copyright information.

=item B<license>

Display license information (Artistic License 2.0).

=item B<quit>, B<exit>, B<q>

Exit the REPL and return to the shell. Alternatively, press Ctrl+D (EOF).

=back

=head1 EXAMPLES

=head2 Basic Execution

    # Execute a script
    sidef script.sf

    # With command-line arguments
    sidef script.sf arg1 arg2

    # Read from STDIN
    cat script.sf | sidef -
    sidef script.sf < input.txt

=head2 One-Liner Examples

Mathematical calculations:

    # Sum of squares
    sidef -E '100.of { |i| i**2 }.sum.say'

    # First 20 primes
    sidef -E '20.pn_primes.say'

    # Check if number is prime
    sidef -E 'say (2**127 - 1 -> is_prime)'

    # High-precision pi
    sidef -P 100 -E 'say Num.pi'

Text processing:

    # Convert to uppercase
    echo "hello" | sidef -E 'STDIN.slurp.uc.print'

    # Filter lines matching pattern
    sidef -E 'STDIN.lines.grep(/pattern/).each{.say}' < file.txt

    # Number lines
    sidef -E 'STDIN.lines.each_kv{|i,v| say "#{i+1}: #{v}"}' < file.txt

=head2 Development Workflow

Check syntax before running:

    sidef -C script.sf && sidef script.sf

Optimize and execute:

    sidef -O1 script.sf                     # Recommended
    sidef -O2 computation.sf                # Aggressive

Debug with parser warnings:

    sidef -k -w script.sf                   # Warnings with traces
    sidef -k -W script.sf                   # Fatal warnings

Enable precompilation for large scripts:

    sidef -s large_project.sf               # Cache compiled code

Combine options for maximum performance:

    sidef -O1 -s script.sf                  # Optimize and cache

=head2 Compilation Examples

Compile to standalone Perl program:

    sidef -c -o myapp.pl script.sf
    chmod +x myapp.pl
    ./myapp.pl

Translate to Perl for inspection:

    sidef -R perl script.sf | less

Normalize Sidef code style:

    sidef -r script.sf > normalized.sf

=head2 Number Theory with External Tools

    # Factor with YAFU
    sidef -N 'USE_YAFU=true' -E 'say factor(2**256 + 1)'

    # Count primes with primecount
    sidef -N 'USE_PRIMECOUNT=true' -E 'say prime_count(10**12)'

    # Use FactorDB
    sidef -N 'USE_FACTORDB=true' -E 'say factor(2**512 + 1)'

=head1 ENVIRONMENT

=over 4

=item B<SIDEF_CONFIG_DIR>

Override the default user configuration directory. Default: C<~/.config/sidef/>

    export SIDEF_CONFIG_DIR=/path/to/config

=item B<HOME>

Used to determine the user's home directory for the default configuration path (C<~/.config/sidef/>). Also consulted via C<LOGDIR> as a fallback on some systems.

=item B<XDG_CONFIG_DIR>

If set, used instead of C<HOME> to locate the configuration directory, following the XDG Base Directory specification.

=item B<PERL5LIB>

Colon-separated list of directories prepended to Perl's C<@INC>. Affects which Sidef and CPAN modules are loaded.

    export PERL5LIB=/path/to/extra/lib

=item B<PERL5OPT>

Default options passed to the Perl interpreter when running Sidef.

=item B<TERM>

Terminal type; affects readline behavior in the interactive REPL.

=back

=head1 FILES

=over 4

=item F<~/.sidef/>

User configuration directory. Created automatically on first run.

=item F<~/.sidef/sidef_history.txt>

REPL command history. Persists across sessions.

=item F<~/.sidef/cache/>

Precompiled code cache directory. Used when B<-s> flag is enabled.

=item F</usr/local/lib/sidef/>

System-wide module directory (typical location).

=item F<*.sf>

Sidef source files (conventional extension). Can use any extension or none.

=back

=head1 EXIT STATUS

=over 4

=item B<0>

Successful execution. Program ran without errors.

=item B<1>

General error. Includes syntax errors, runtime errors, unhandled exceptions, file not found, and permission denied.

=item B<2>

No input provided when expected.

=back

=head1 DIAGNOSTICS

Common error messages and their meanings:

=over 4

=item B<Can't open sidef script "filename": No such file or directory>

The specified script file does not exist or is not readable. Check file name spelling and permissions.

=item B<Syntax error at line N>

Parser encountered invalid syntax at the specified line. Use B<-k> for more detailed diagnostics.

=item B<Invalid precision: C<< <<value>> >> (expected a positive integer)>

The value provided to B<-P> must be a positive integer.

=item B<No code specified for -E>

The B<-E> option requires a code argument.

=item B<Invalid format: C<< <<option>> >>!>

The B<-N> option format is incorrect. Expected format: C<'NAME1=VALUE1; NAME2=VALUE2'>

=item B<"Data::Dump" is not installed!>

The B<-D> option requires the Perl module Data::Dump. Install with: C<cpan Data::Dump> or C<cpanm Data::Dump>

=item B<Variable 'name' is not declared in the current scope>

Attempting to use an undeclared variable. Declare with C<var>, C<global>, C<const>, or C<define>.

=item B<Stopped by user...>

The user interrupted execution (e.g., Ctrl+C) during test mode (B<-t>).

=item B<[ERROR] Can't parse the script `filename`: ...>

Test mode (B<-t>) failed to parse the named script. The error detail follows the colon.

=item B<[ERROR] Error encountered on script `filename`: ...>

Test mode (B<-t>) encountered a runtime error while executing the named script. The error detail follows the colon.

=item B<Can't open file C<< <<filename>> >> for reading: ...>

A file I/O operation failed because the file could not be opened for reading. Check that the file exists and is readable.

=item B<Can't open file C<< <<filename>> >> for writing: ...>

A file I/O operation failed because the file could not be opened for writing. Check directory permissions.

=back

=head1 BUGS AND LIMITATIONS

=head2 Known Limitations

=over 4

=item * Code using C<eval()> may not compile correctly with B<-c>

=item * Very large precision (>100,000 digits) may cause performance issues

=item * Precompilation cache can grow large with many unique scripts

=item * Some REPL features may not work identically to script execution

=back

=head2 Reporting Bugs

Report bugs on GitHub: L<https://github.com/trizen/sidef/issues>

Please include:

=over 4

=item * Sidef version (C<sidef -v>), OS, and Perl version (C<perl -v>)

=item * Complete error message with stack trace

=item * Minimal code example reproducing the issue

=item * Expected behavior vs. actual behavior

=back

=head1 PERFORMANCE TIPS

=over 4

=item * B<Use C<-O1> for production scripts>

Constant folding evaluates pure constant expressions at compile time, often giving a noticeable speedup with no code changes:

    sidef -O1 script.sf

=item * B<Use C<-s> for scripts run repeatedly>

Precompilation caching skips the parse/compile phase on subsequent runs of unchanged code:

    sidef -s script.sf

=item * B<Combine C<-O1 -s> for best results>

    sidef -O1 -s script.sf

=item * B<Use external tools via C<-N> for heavy number theory>

For computationally expensive operations such as large-integer factorization or prime counting, enabling external programs like C<yafu>, C<primecount>, or C<pari-gp> can dramatically reduce runtime:

    sidef -N 'USE_PRIMECOUNT=true; USE_YAFU=true' script.sf

=item * B<REPL overhead>

The interactive REPL has per-line compilation overhead. For performance-sensitive work, prefer executing a script file directly over typing the same code interactively.

=back

=head1 HISTORY

Sidef was started in 2013 by Daniel Șuteu as a personal language experiment and has been actively maintained and extended since then. Major milestones:

=over 4

=item * B<2013> - Project started; core parser and object system.

=item * B<2015> - Arbitrary-precision arithmetic (GMP/MPFR/MPC).

=item * B<2016> - First CPAN release.

=item * B<2018+> - Extensive number theory library; external tool integrations (YAFU, PARI/GP, primecount).

=item * B<Present> - Ongoing improvements to the standard library, optimiser, and REPL.

=back

Full release history: L<https://github.com/trizen/sidef/releases>

